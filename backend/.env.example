# Vera Backend Environment Variables

# Gmail OAuth
VERA_GMAIL_TOKEN=tokens/gmail_token.json
VERA_GMAIL_CREDS=credentials/gmail_credentials.json

# Microsoft/Outlook OAuth
VERA_OUTLOOK_TOKEN=tokens/outlook_token.json
VERA_OUTLOOK_CLIENT_ID=your-azure-app-client-id
VERA_OUTLOOK_CLIENT_SECRET=your-azure-app-client-secret
VERA_OUTLOOK_TENANT_ID=common

# Gemini API
VERA_GEMINI_API_KEY=your-gemini-api-key
