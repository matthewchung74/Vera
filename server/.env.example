# LiveKit Server Configuration
# Generate these with: docker run --rm livekit/livekit-server generate-keys
LIVEKIT_API_KEY=your_api_key_here
LIVEKIT_API_SECRET=your_api_secret_here

# Google Gemini API Key (same as currently used in iOS app)
GOOGLE_API_KEY=your_gemini_api_key_here

# Server URL (for iOS app to connect)
# For local development: ws://localhost:7880
# For production: wss://your-domain.com
LIVEKIT_URL=ws://localhost:7880
